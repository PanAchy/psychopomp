{
  "version": 2,
  "id": "effect-ts",
  "durationNanos": 88829999997,
  "actors": [
    {
      "id": "stage",
      "recipe": "stage",
      "data": {
        "elements": [
          {
            "at": [
              960.0,
              380.0,
              40.0
            ],
            "face": "sans-bold",
            "id": "intro-title",
            "kind": "label",
            "size": 68.0,
            "spans": [
              {
                "text": "Why Effect?"
              }
            ]
          },
          {
            "at": [
              960.0,
              560.0,
              40.0
            ],
            "face": "light",
            "id": "intro-body",
            "kind": "label",
            "size": 36.0,
            "spans": [
              {
                "text": "Your program is a description of work, not a pile of side effects.",
                "tone": "muted"
              }
            ]
          },
          {
            "at": [
              960.0,
              380.0,
              40.0
            ],
            "face": "sans-bold",
            "id": "hidden-title",
            "kind": "label",
            "size": 68.0,
            "spans": [
              {
                "text": "Plain TypeScript hides three things"
              }
            ]
          },
          {
            "at": [
              960.0,
              560.0,
              40.0
            ],
            "face": "light",
            "id": "hidden-body",
            "kind": "label",
            "size": 36.0,
            "spans": [
              {
                "text": "Thrown errors. Imported dependencies. Hand-rolled retries.",
                "tone": "muted"
              }
            ]
          },
          {
            "at": [
              960.0,
              380.0,
              40.0
            ],
            "face": "sans-bold",
            "id": "throws-title",
            "kind": "label",
            "size": 68.0,
            "spans": [
              {
                "text": "A function that throws tells you nothing"
              }
            ]
          },
          {
            "at": [
              960.0,
              560.0,
              40.0
            ],
            "face": "light",
            "id": "throws-body",
            "kind": "label",
            "size": 36.0,
            "spans": [
              {
                "text": "The caller must know which errors exist. The compiler cannot check they were handled.",
                "tone": "muted"
              }
            ]
          },
          {
            "at": [
              960.0,
              380.0,
              40.0
            ],
            "face": "sans-bold",
            "id": "typed-title",
            "kind": "label",
            "size": 68.0,
            "spans": [
              {
                "text": "Errors become part of the signature"
              }
            ]
          },
          {
            "at": [
              960.0,
              560.0,
              40.0
            ],
            "face": "light",
            "id": "typed-body",
            "kind": "label",
            "size": 36.0,
            "spans": [
              {
                "text": "Success and failure travel together. An unhandled failure is a compile error.",
                "tone": "muted"
              }
            ]
          },
          {
            "at": [
              960.0,
              380.0,
              40.0
            ],
            "face": "sans-bold",
            "id": "layers-title",
            "kind": "label",
            "size": 68.0,
            "spans": [
              {
                "text": "Dependencies become a value"
              }
            ]
          },
          {
            "at": [
              960.0,
              560.0,
              40.0
            ],
            "face": "light",
            "id": "layers-body",
            "kind": "label",
            "size": 36.0,
            "spans": [
              {
                "text": "A Layer declares what a program needs. You supply it at the edge.",
                "tone": "muted"
              }
            ]
          },
          {
            "at": [
              960.0,
              380.0,
              40.0
            ],
            "face": "sans-bold",
            "id": "builtin-title",
            "kind": "label",
            "size": 68.0,
            "spans": [
              {
                "text": "Concurrency comes with it"
              }
            ]
          },
          {
            "at": [
              960.0,
              560.0,
              40.0
            ],
            "face": "light",
            "id": "builtin-body",
            "kind": "label",
            "size": 36.0,
            "spans": [
              {
                "text": "Retries, timeouts, cancellation, and parallel work compose as values.",
                "tone": "muted"
              }
            ]
          },
          {
            "at": [
              960.0,
              380.0,
              40.0
            ],
            "face": "sans-bold",
            "id": "suite-title",
            "kind": "label",
            "size": 68.0,
            "spans": [
              {
                "text": "One model for the whole toolkit"
              }
            ]
          },
          {
            "at": [
              960.0,
              560.0,
              40.0
            ],
            "face": "light",
            "id": "suite-body",
            "kind": "label",
            "size": 36.0,
            "spans": [
              {
                "text": "Schema for untrusted input. Stream for events. Schedule for policy.",
                "tone": "muted"
              }
            ]
          },
          {
            "at": [
              960.0,
              380.0,
              40.0
            ],
            "face": "sans-bold",
            "id": "cost-title",
            "kind": "label",
            "size": 68.0,
            "spans": [
              {
                "text": "The cost is real"
              }
            ]
          },
          {
            "at": [
              960.0,
              560.0,
              40.0
            ],
            "face": "light",
            "id": "cost-body",
            "kind": "label",
            "size": 36.0,
            "spans": [
              {
                "text": "It is a large abstraction, and the error messages take practice.",
                "tone": "muted"
              }
            ]
          },
          {
            "at": [
              960.0,
              380.0,
              40.0
            ],
            "face": "sans-bold",
            "id": "when-title",
            "kind": "label",
            "size": 68.0,
            "spans": [
              {
                "text": "Use it where correctness pays"
              }
            ]
          },
          {
            "at": [
              960.0,
              560.0,
              40.0
            ],
            "face": "light",
            "id": "when-body",
            "kind": "label",
            "size": 36.0,
            "spans": [
              {
                "text": "Not in a prototype. Not in a script that runs once.",
                "tone": "muted"
              }
            ]
          },
          {
            "at": [
              960.0,
              380.0,
              40.0
            ],
            "face": "sans-bold",
            "id": "close-title",
            "kind": "label",
            "size": 68.0,
            "spans": [
              {
                "text": "Start at one boundary"
              }
            ]
          },
          {
            "at": [
              960.0,
              560.0,
              40.0
            ],
            "face": "light",
            "id": "close-body",
            "kind": "label",
            "size": 36.0,
            "spans": [
              {
                "text": "Measure the pain it removes. Let the rest follow.",
                "tone": "muted"
              }
            ]
          },
          {
            "at": [
              960.0,
              900.0,
              20.0
            ],
            "face": "sans-bold",
            "id": "mark",
            "kind": "label",
            "size": 26.0,
            "spans": [
              {
                "text": "Effect · TypeScript",
                "tone": "muted"
              }
            ]
          }
        ],
